{
  "name": "sitwell-weblium-blocks",
  "version": "0.1.0",
  "private": true,
  "description": "Custom HTML/CSS/JS blocks embedded in the Weblium-hosted sitwell.com.ua",
  "scripts": {
    "build": "node scripts/build.js",
    "build:slipmat": "node scripts/build.js slipmat-generator",
    "build:order": "node scripts/build.js slipmat-order",
    "dev": "python3 -m http.server 5173 --directory .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5"
  }
}
